{
  "id": "quiz",
  "scripts": [
    "cloze.js",
    "quiz.js",
    "module.js"
  ],
  "styles": [
    "quiz.css",
    "integrations.css",
    "intro.css",
    "results.css",
    "cloze.css",
    "image-answers.css",
    "cards.css"
  ],
  "plugins": [
    {
      "name": "RevealQuiz",
      "config": {
        "quiz": {
          "presentationKeyboard": true,
          "allowNumberKeys": false,
          "shuffleOptions": false,
          "includeScore": true,
          "cards": false,
          "disableOnCheck": false,
          "defaultCorrect": "",
          "defaultIncorrect": "",
          "disableReset": false
        }
      }
    }
  ],
  "filters": [
    "filter.lua"
  ]
}
