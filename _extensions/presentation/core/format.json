{
  "title": "Presentation",
  "author": "Max Krischeu",
  "version": "0.2.0",
  "quarto-required": ">=1.10.0",
  "contributes": {
    "project": {
      "project": {
        "type": "default",
        "post-render": "quarto run .quarto/presentation/hooks.ts",
        "preview": {
          "serve": {
            "cmd": "quarto run .quarto/presentation/preview.ts --port {port} --live-reload",
            "ready": "Presentation preview ready:"
          }
        }
      },
      "format": "presentation-revealjs",
      "document-hooks": true,
      "document-hooks-bootstrap": "server/bootstrap.ts"
    },
    "formats": {
      "revealjs": {
        "lang": "en",
        "width": 1280,
        "height": 720,
        "margin": 0,
        "min-scale": 0.01,
        "max-scale": 100,
        "center": false,
        "center-title-slide": false,
        "controls": false,
        "progress": false,
        "slide-number": false,
        "menu": false,
        "transition": "none",
        "background-transition": "none",
        "hash": true,
        "history": true,
        "theme": [
          "default",
          "ui/theme.scss"
        ],
        "filters": [
          "server/filter.lua",
          "ui/filter.lua"
        ],
        "revealjs-plugins": [
          "presentation"
        ],
        "chalkboard": {
          "theme": "whiteboard",
          "buttons": false,
          "transition": 1,
          "boardmarker-width": 3
        },
        "quiz": {
          "includeScore": true,
          "presentationKeyboard": true,
          "allowNumberKeys": false,
          "shuffleOptions": false
        },
        "drop": {
          "engine": "pyodide",
          "button": false,
          "shortcut": "t"
        },
        "embed-resources": false
      }
    }
  }
}
